{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run AnimMate Studio",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv313\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8001",
				"--reload"
			],
			"isBackground": true,
			"problemMatcher": [
				"$python"
			]
		}
	]
}